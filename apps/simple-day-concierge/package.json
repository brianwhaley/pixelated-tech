{
  "name": "simple-day-concierge",
  "version": "1.0.1",
  "private": true,
  "description": "Simple Day Concierge - Where Simplicity Meets Exceptional Service",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/brianwhaley/pixelated-tech.git/apps/simple-day-concierge"
  },
  "scripts": {
    "dev": "npm run clean && NODE_OPTIONS='--inspect' next dev --webpack -p 3012 --experimental-https",
    "build": "npm run clean && NODE_ENV=production next build --webpack",
    "start": "npm run clean && next build --webpack && next start",
    "lint": "eslint --fix",
    "test": "vitest run --silent",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "clean": "rm -rf .next && rm -rf out",
    "generate-site-images": "node $(node -e 'console.log(require.resolve(\"@pixelated-tech/components/scripts/generate-site-images.js\"))')",
    "config:vault": "npx tsx $(node -e 'console.log(require.resolve(\"@pixelated-tech/components/scripts/config-vault.js\"))')",
    "config:encrypt": "npm run config:vault -- encrypt src/app/config/pixelated.config.json",
    "config:decrypt": "npm run config:vault -- decrypt src/app/config/pixelated.config.json.enc",
    "config:postbuild": "npm run config:vault -- postbuild",
    "release:prep": "node $(node -e 'console.log(require.resolve(\"@pixelated-tech/components/scripts/release-prep.js\"))')",
    "release": "bash $(node -e 'console.log(require.resolve(\"@pixelated-tech/components/scripts/release.sh\"))')",
    "update": "bash $(node -e 'console.log(require.resolve(\"@pixelated-tech/components/scripts/update.sh\"))')"
  },
  "dependencies": {
    "@aws-sdk/client-amplify": "^3.1067.0",
    "@aws-sdk/client-cloudwatch": "^3.1067.0",
    "@aws-sdk/client-dynamodb": "^3.1067.0",
    "@aws-sdk/client-iam": "^3.1067.0",
    "@aws-sdk/client-route-53": "^3.1067.0",
    "@pixelated-tech/components": "*",
    "@storybook/addon-a11y": "^10.4.4",
    "@storybook/addon-docs": "^10.4.4",
    "@storybook/react-dom-shim": "^10.4.4",
    "@storybook/react-webpack5": "^10.4.4",
    "next": "^16.2.9",
    "react": "^19.2.6",
    "sass": "^1.101.0",
    "storybook": "^10.4.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.7.0",
    "@types/react": "^19.2.14",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.2.9",
    "eslint-import-resolver-typescript": "^4.4.4",
    "glob": "^13.0.6",
    "html-entities": "^2.3.3",
    "react-dom": "^19.2.6",
    "typescript": "^6.0.2",
    "vitest": "^4.1.8"
  },
  "overrides": {},
  "deployMarker": "2026-06-09T00:54:08.871Z"
}
