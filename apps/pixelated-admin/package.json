{
  "name": "pixelated-admin",
  "version": "1.10.27",
  "private": true,
  "scripts": {
    "dev": "npm run clean && NODE_OPTIONS='--inspect' next dev --webpack -p 3006 --experimental-https",
    "build": "npm run clean && NODE_ENV=production next build --webpack",
    "prepare:artifact": "node scripts/prepare-deployment-artifact.mjs",
    "start": "npm run clean && next build --webpack && next start",
    "lint": "eslint --fix",
    "clean": "rm -rf .next && rm -rf out",
    "json2csv": "node src/app/scripts/json-to-csv.js",
    "search-public": "node src/app/scripts/search-public.js",
    "cleanup-one-row": "bash src/app/scripts/cleanup-one-row.sh",
    "test": "vitest run --silent",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "generate-site-images": "node $(node -e 'console.log(require.resolve(\"@pixelated-tech/components/scripts/generate-site-images.js\"))')",
    "config:vault": "npx tsx $(node -e 'console.log(require.resolve(\"@pixelated-tech/components/scripts/config-vault.js\"))')",
    "config:encrypt": "npm run config:vault -- encrypt src/app/config/pixelated.config.json",
    "config:decrypt": "npm run config:vault -- decrypt src/app/config/pixelated.config.json.enc",
    "config:postbuild": "npm run config:vault -- postbuild",
    "release:prep": "node $(node -e 'console.log(require.resolve(\"@pixelated-tech/components/scripts/release-prep.js\"))')",
    "release": "bash $(node -e 'console.log(require.resolve(\"@pixelated-tech/components/scripts/release.sh\"))')",
    "update": "bash $(node -e 'console.log(require.resolve(\"@pixelated-tech/components/scripts/update.sh\"))')"
  },
  "dependencies": {
    "@babel/parser": "^8.1.0",
    "@pixelated-tech/components": "*",
    "axe-core": "^4.14.0",
    "globals": "^17.14.0",
    "next": "^16.4.6",
    "next-auth": "^4.24.15",
    "prop-types": "^15.8.1",
    "puppeteer": "^25.0.2",
    "react": "^19.2.7"
  },
  "devDependencies": {
    "@aws-sdk/client-amplify": "^3.1167.0",
    "@aws-sdk/client-cloudwatch": "^3.1165.0",
    "@aws-sdk/client-dynamodb": "^3.1165.0",
    "@aws-sdk/client-iam": "^3.1167.0",
    "@aws-sdk/client-route-53": "^3.1165.0",
    "@aws-sdk/client-sesv2": "^3.1165.0",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "9.39.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.9",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/prop-types": "^15.7.15",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19",
    "@types/ssh2": "^1.15.6",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.4.6",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "glob": "^14.0.6",
    "googleapis": "^189.0.0",
    "jsdom": "^29.1.1",
    "marked": "^18.2.0",
    "nodemailer": "^10.5.0",
    "react-dom": "^19.2.6",
    "sass": "^1.108.1",
    "typescript": "6.0.2",
    "vitest": "^5.1.0"
  },
  "overrides": {},
  "deployMarker": "2026-11-06T04:09:02.000Z"
}
