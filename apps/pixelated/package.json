{
	"name": "pixelatedtech",
	"version": "4.7.0",
	"private": true,
	"author": {
		"name": "Pixelated Technologies",
		"url": "https://www.pixelated.tech/"
	},
	"scripts": {
		"dev": "npm run clean && NODE_OPTIONS='--inspect' next dev --webpack -p 3004 --experimental-https",
		"build": "npm run clean && NODE_ENV=production next build --webpack",
		"start": "npm run clean && next build --webpack && next start --webpack -p 3004",
		"lint": "eslint --fix",
		"clean": "rm -rf .next && rm -rf out",
		"test": "vitest run --silent",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest",
		"test:ui": "vitest --ui",
		"generate-site-images": "node $(node -e 'console.log(require.resolve(\"@pixelated-tech/components/scripts/generate-site-images.js\"))')",
		"config:vault": "npx tsx $(node -e 'console.log(require.resolve(\"@pixelated-tech/components/scripts/config-vault.js\"))')",
		"config:encrypt": "npm run config:vault -- encrypt src/app/config/pixelated.config.json",
		"config:decrypt": "npm run config:vault -- decrypt src/app/config/pixelated.config.json.enc",
		"config:postbuild": "npm run config:vault -- postbuild",
		"release:prep": "node $(node -e 'console.log(require.resolve(\"@pixelated-tech/components/scripts/release-prep.js\"))')",
		"release": "bash $(node -e 'console.log(require.resolve(\"@pixelated-tech/components/scripts/release.sh\"))')",
		"update": "bash $(node -e 'console.log(require.resolve(\"@pixelated-tech/components/scripts/update.sh\"))')"
	},
	"scripts-unused": {
		"dev": "next dev --turbopack",
		"update": "UPDATES=$(npm outdated | awk 'NR>1 {print $1\"@\"$3}' || true); if [ -n \"$UPDATES\" ]; then echo \"Updating the following packages: $UPDATES\"; echo \"$UPDATES\" | xargs npm install --force --save 2>/dev/null || true; echo \"✅ Successfully updated: $UPDATES\"; else echo \"✅ No dependency updates needed.\"; fi; npm audit fix 2>/dev/null || true",
		"update-all": "npm run update && UPDATES=$(npm outdated --dev | awk 'NR>1 {print $1\"@\"$3}') && [ -n \"$UPDATES\" ] && echo \"$UPDATES\" | xargs npm install --force --save-dev; UPDATES=$(npm outdated --optional | awk 'NR>1 {print $1\"@\"$3}') && [ -n \"$UPDATES\" ] && echo \"$UPDATES\" | xargs npm install --force --save-optional; npm audit fix"
	},
	"dependencies": {
		"@pixelated-tech/components": "*",
		"next": "^16.2.6",
		"prop-types": "15.8.1",
		"react": "^19.2.6"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.5",
		"@eslint/js": "9.39.4",
		"@eslint/json": "^1.2.0",
		"@next/eslint-plugin-next": "^16.2.4",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^25.7.0",
		"@types/prop-types": "^15.7.15",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@types/testing-library__react": "^10.0.1",
		"@typescript-eslint/eslint-plugin": "^8.59.3",
		"@typescript-eslint/parser": "^8.59.3",
		"@vitest/coverage-v8": "^4.1.7",
		"@vitest/ui": "^4.1.7",
		"css-loader": "^7.1.4",
		"eslint": "9.39.4",
		"eslint-config-next": "^16.2.2",
		"glob": "^13.0.6",
		"react-dom": "^19.2.6",
		"sass": "^1.99.0",
		"sass-loader": "^17.0.0",
		"style-loader": "^4.0.0",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.59.3",
		"vitest": "^4.1.7",
		"html-entities": "^2.3.3",
		"webpack-dev-server": "^5.2.4"
	}
}
