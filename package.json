{
  "name": "pixelated-tech",
  "version": "1.0.15",
  "private": true,
  "description": "Pixelated Technologies - Unified platform monorepo",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*",
    "shared/*"
  ],
  "scripts": {
    "build": "npm run build -ws",
    "test": "npm run test -ws",
    "test:coverage": "npm run test:coverage -ws",
    "lint": "npm run lint -ws",
    "generate-site-images": "node $(node -e 'console.log(require.resolve(\"@pixelated-tech/components/scripts/generate-site-images.js\"))')",
    "config:vault": "npx tsx $(node -e 'console.log(require.resolve(\"@pixelated-tech/components/scripts/config-vault.js\"))')",
    "config:encrypt": "npm run config:vault -- encrypt src/app/config/pixelated.config.json",
    "config:decrypt": "npm run config:vault -- decrypt src/app/config/pixelated.config.json.enc",
    "reinstall:workspaces": "find . -name 'node_modules' -type d -prune -print0 | xargs -0 rm -rf && find . -name 'package-lock.json' -type f -print0 | xargs -0 rm -f && npm install",
    "release:prep": "node $(node -e 'console.log(require.resolve(\"@pixelated-tech/components/scripts/release-prep.js\"))')",
    "release": "bash $(node -e 'console.log(require.resolve(\"@pixelated-tech/components/scripts/release.sh\"))')",
    "update": "bash $(node -e 'console.log(require.resolve(\"@pixelated-tech/components/scripts/update.sh\"))')",
    "deploymarker:update": "find . -type f -path '*/siteconfig.json' -print0 | xargs -0 -I {} node -e \"const fs=require('fs'); const p=process.argv[1]; const json=JSON.parse(fs.readFileSync(p,'utf8')); json.deployMarker=new Date().toISOString(); fs.writeFileSync(p, JSON.stringify(json, null, 2) + '\\n');\" {}",
    "bump:patch:workspaces": "for dir in packages/* apps/* tools/* shared/*; do if [ -f \"$dir/package.json\" ]; then echo \"Bumping patch in $dir\"; (cd \"$dir\" && npm version patch --force --no-git-tag-version); fi; done"
  },
  "scripts-disabled": {
    "release:monorepo": "bash $(node -e 'console.log(require.resolve(\"@pixelated-tech/components/scripts/release.sh\"))') --monorepo"
  },
  "dependencies": {
    "@aws-sdk/client-amplify": "^3.1045.0",
    "@aws-sdk/client-cloudwatch": "^3.1045.0",
    "@aws-sdk/client-iam": "^3.1045.0",
    "@aws-sdk/client-route-53": "^3.1045.0",
    "@next/third-parties": "^16.2.6",
    "@types/testing-library__react": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "axe-core": "^4.11.3",
    "next": "^16.2.6",
    "next-auth": "^4.24.14",
    "react-redux": "^9.3.0",
    "typescript-eslint": "^8.60.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@pixelated-tech/components": "^3.17.0",
    "@storybook/react-dom-shim": "^10.3.6",
    "@storybook/react-webpack5": "^10.3.6",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.7",
    "@vitest/ui": "^4.1.7",
    "eslint": "9.39.4",
    "glob": "^13.0.6",
    "jsdom": "^29.1.1",
    "puppeteer": "^25.0.2",
    "vitest": "^4.1.7"
  },
  "overrides": {}
}
