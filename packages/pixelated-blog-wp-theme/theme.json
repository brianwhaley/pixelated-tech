{
	"$schema": "https://schemas.wp.org/wp/6.9/theme.json",
	"settings": {
		"appearanceTools": true,
		"color": {
			"palette": [
				{
					"color": "#336699",
					"name": "Primary",
					"slug": "primary"
				},
				{
					"color": "#666666",
					"name": "Secondary",
					"slug": "secondary"
				},
				{
					"color": "#DEDEDE",
					"name": "Tertiary",
					"slug": "tertiary"
				},
				{
					"color": "#F5F5F5",
					"name": "Accent 1",
					"slug": "accent1"
				},
				{
					"color": "#666666",
					"name": "Accent 2",
					"slug": "accent2"
				},
				{
					"color": "#000000",
					"name": "Accent 3",
					"slug": "accent3"
				},
				{
					"color": "#333333",
					"name": "Body Text",
					"slug": "body-text"
				},
				{
					"color": "#336699",
					"name": "Header Text",
					"slug": "header-text"
				},
				{
					"color": "#EFEFEF",
					"name": "Page Background",
					"slug": "page-background"
				}
			]
		},
		"layout": {
			"contentSize": "650px",
			"wideSize": "1200px"
		},
		"spacing": {
			"spacingSizes": [
				{
					"name": "1",
					"size": "clamp(1.5rem, 5vw, 2rem)",
					"slug": "30"
				},
				{
					"name": "3",
					"size": "clamp(2.5rem, 8vw, 2.5rem)",
					"slug": "50"
				},
				{
					"name": "4",
					"size": "clamp(2rem, 10vw, 2rem)",
					"slug": "60"
				},
				{
					"name": "6",
					"size": "clamp(7rem, 14vw, 11rem)",
					"slug": "80"
				}
			],
			"units": [
				"%",
				"px",
				"em",
				"rem",
				"vh",
				"vw"
			]
		},
		"typography": {
			"dropCap": false,
			"fluid": true,
			"fontFamilies": [
				{
					"fontFamily": "\"Montserrat\", sans-serif",
					"name": "Montserrat",
					"slug": "montserrat"
				},
				{
					"fontFamily": "\"Roboto\", sans-serif",
					"name": "Roboto",
					"slug": "roboto"
				}
			],
			"fontSizes": [
				{
					"fluid": {
						"max": "0.85rem",
						"min": "0.65rem"
					},
					"size": "0.85rem",
					"slug": "x-small"
				},
				{
					"fluid": {
						"max": "1rem",
						"min": "0.85rem"
					},
					"size": "1rem",
					"slug": "small"
				},
				{
					"fluid": {
						"max": "1.5rem",
						"min": "1rem"
					},
					"size": "1.5rem",
					"slug": "medium"
				},
				{
					"fluid": {
						"max": "2rem",
						"min": "1.5rem"
					},
					"size": "2rem",
					"slug": "large"
				},
				{
					"fluid": {
						"max": "3rem",
						"min": "2rem"
					},
					"size": "3rem",
					"slug": "x-large"
				},
				{
					"fluid": {
						"max": "4rem",
						"min": "3rem"
					},
					"size": "4rem",
					"slug": "xx-large"
				}
			]
		},
		"useRootPaddingAwareAlignments": true
	},
	"styles": {
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--roboto)"
		},
		"blocks": {
			"core/button": {
			},
			"core/comment-author-name": {
			},
			"core/comment-content": {
				"spacing": {
					"margin": {
						"top": "0"
					}
				}
			},
			"core/comment-date": {
			},
			"core/comment-edit-link": {
			},
			"core/comment-reply-link": {
			},
			"core/comments-pagination": {
				"elements": {
					"link": {
					}
				},
				"spacing": {
					"margin": {
						"top": "var(--wp--preset--spacing--40)"
					}
				}
			},
			"core/comments-title": {
				"spacing": {
					"margin": {
						"bottom": "var(--wp--preset--spacing--40)"
					}
				}
			},
			"core/heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--montserrat)"
				}
			},
			"core/navigation": {
			},
			"core/post-author": {
			},
			"core/post-content": {
			},
			"core/post-date": {
			},
			"core/post-excerpt": {
			},
			"core/post-terms": {
			},
			"core/post-title": {
				"elements": {
					"link": {
					}
				},
				"spacing": {
					"margin": {
						"bottom": "1.25rem",
						"top": "1.25rem"
					}
				}
			},
			"core/pullquote": {
				"border": {
					"style": "solid",
					"width": "1px 0"
				},
				"spacing": {
					"margin": {
						"bottom": "var(--wp--preset--spacing--40) !important",
						"top": "var(--wp--preset--spacing--40) !important"
					}
				}
			},
			"core/query": {
				"elements": {
					"h2": {
						"typography": {
							"fontSize": "var(--wp--preset--font-size--x-large)"
						}
					}
				}
			},
			"core/query-pagination": {
				"elements": {
					"link": {
					}
				}
			},
			"core/quote": {
				"border": {
					"width": "1px"
				},
				"spacing": {
					"padding": {
						"left": "var(--wp--preset--spacing--30)",
						"right": "var(--wp--preset--spacing--30)"
					}
				}
			},
			"core/site-title": {
				"elements": {
					"link": {
					}
				}
			}
		},
		"color": {
			"background": "var(--wp--preset--color--page-background)",
			"text": "var(--wp--preset--color--body-text)"
		},
		"elements": {
			"button": {
				":active": {
					"color": {
						"background": "var(--wp--preset--color--secondary)",
						"text": "var(--wp--preset--color--page-background)"
					}
				},
				":focus": {
					"color": {
						"background": "var(--wp--preset--color--body-text)",
						"text": "var(--wp--preset--color--page-background)"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--body-text)",
						"text": "var(--wp--preset--color--page-background)"
					}
				},
				":visited": {
					"color": {
						"text": "var(--wp--preset--color--body-text)"
					}
				},
				"border": {
					"radius": "0"
				},
				"color": {
					"background": "var(--wp--preset--color--body-text)",
					"text": "var(--wp--preset--color--page-background)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"fontWeight": "800"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"fontWeight": "700"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"textTransform": "uppercase"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-small)"
				}
			},
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--montserrat)",
					"fontWeight": "600",
					"lineHeight": "1.2"
				}
			},
			"link": {
				":active": {
				},
				":focus": {
				},
				":hover": {
					"typography": {
						"textDecoration": "underline"
					}
					},
					"color": {
						"text": "var(--wp--preset--color--primary)"
					},
				"typography": {
					"textDecoration": "none"
				}
			}
		},
		"spacing": {
			"blockGap": "1.5rem",
			"padding": {
				"left": "var(--wp--preset--spacing--30)",
				"right": "var(--wp--preset--spacing--30)"
			}
		}
	},
	"templateParts": [
		{
			"area": "header",
			"name": "header",
			"title": "Header"
		},
		{
			"area": "footer",
			"name": "footer",
			"title": "Footer"
		},
		{
			"area": "uncategorized",
			"name": "comments",
			"title": "Comments"
		}
	],
	"version": 3
}